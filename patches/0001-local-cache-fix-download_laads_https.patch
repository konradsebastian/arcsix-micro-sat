         for i in range(len(primary_commands)):
 
-            fname_local = fnames_local[i]
+            fname_local = fnames_to_download[i] # BUGFIX (Schmidt lab, 2026-10-23): was fnames_local[i], which now also holds cached files and is no longer index-aligned with primary_commands/backup_commands
 
             if verbose:
