+def _backup_download_tool_available():
+    """
+    BUGFIX (Schmidt lab, 2026-10-24): download_laads_https/download_lance_https/
+    download_nsidc_https each fall back to running a backup shell command (wget)
+    via os.system() whenever the primary one (curl) produces a file that fails
+    final_file_check() -- but none of them ever checked that the backup tool is
+    actually installed first. On a machine without wget (e.g. a stock macOS
+    install, which ships curl but not wget), the backup attempt failed with an
+    easy-to-miss "sh: wget: command not found" on stderr, final_file_check()
+    unsurprisingly still failed afterward, and the download was reported as
+    fully failed -- looking exactly like a real second attempt was made and
+    also failed, when the backup command never actually ran at all.
+
+    Returns True iff 'wget' is found on PATH.
+    """
+    return shutil.which('wget') is not None
